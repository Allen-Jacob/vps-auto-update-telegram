# Notification prefix shown at the beginning of each Telegram message.
VPS_LABEL="VPS NETBIRD"

# NetBird Docker Compose project.
COMPOSE_FILE=/root/docker-compose.yml
TARGETS=netbird-server,dashboard,proxy

# First detection starts this safety window. A new image digest resets the timer.
GRACE_HOURS=24

# HTTPS endpoint that should return 200 or 401 while NetBird is reachable.
# Replace the example with your own NetBird domain.
HEALTHCHECK_URL=https://netbird.example.com/api/instance/version

# Keep the newest backup indefinitely; older backups are removed after this many hours.
BACKUP_DIR=/var/backups/netbird
RETENTION_HOURS=24
